# =================================================
# .env.example — Commit this. Never commit .env.
# =================================================
# Docker Compose auto-loads .env from the project root.
# For local IDE/Spring Boot development without Docker,
# copy .env.local.example (or duplicate this file) and
# set DB_HOST=localhost, REDIS_HOST=localhost.
# =================================================

# -------------------------------------------------
# Application Configuration
# -------------------------------------------------
APP_ENV=development
SERVER_PORT=8080
LOG_LEVEL=INFO
ENABLE_JSON_LOGGING=

# -------------------------------------------------
# Database Configuration
# Docker Compose: DB_HOST=postgres (service name)
# IDE / local:    DB_HOST=localhost
# -------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=street_vendor
DB_USERNAME=postgres
DB_PASSWORD=postgres

# -------------------------------------------------
# Redis Configuration
# -------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PING_ON_STARTUP=true

# -------------------------------------------------
# JWT Configuration
# -------------------------------------------------
JWT_SECRET=your_jwt_secret_key_placeholder
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=7

# -------------------------------------------------
# Security Configuration
# -------------------------------------------------
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_DURATION_MINUTES=15
MAX_FILE_SIZE_PDF_MB=5
MAX_FILE_SIZE_IMAGE_MB=2
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -------------------------------------------------
# Admin Bootstrap Configuration
# -------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminSecurePasswordPlaceholder

# -------------------------------------------------
# Razorpay Configuration
# -------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_key_id_placeholder
RAZORPAY_KEY_SECRET=rzp_test_key_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret_placeholder
RAZORPAY_WEBHOOK_TOLERANCE_SECONDS=300

# -------------------------------------------------
# Cloudflare R2 Configuration
# -------------------------------------------------
R2_ACCESS_KEY=r2_access_key_placeholder
R2_SECRET_KEY=r2_secret_key_placeholder
R2_BUCKET_NAME=your-bucket-name
R2_REGION=auto
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# -------------------------------------------------
# Analytics Configuration
# -------------------------------------------------
ANALYTICS_CRON_EXPRESSION=0 0 1 * * *

# -------------------------------------------------
# Frontend Configuration (Next.js)
# -------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_key_id_placeholder